      "parameters": {
        "jsCode": "const today = new Date();\nconst results = [];\nconst items = $input.all();\n\nfor (const item of items) {\n  const startDate = new Date(item.json['Start Date']);\n  const diffTime = startDate.getTime() - today.getTime();\n  const daysUntilStart = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n\n  results.push({\n    json: {\n      campaignName: item.json['Campaign Name'],\n      daysUntilStart: daysUntilStart,\n      flag: daysUntilStart < 0 ? \"Overdue\" : \"Upcoming\"\n    }\n  });\n}\n\nreturn results;"
      },
