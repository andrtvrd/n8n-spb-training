    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst results = [];\n\nfor (const item of items) {\n  const startDate = new Date(item.json['Start Date']);\n  const daysActive = Math.floor((today.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24));\n  const budget = Number(item.json['Budget']);\n  const budgetTier = budget > 20000 ? \"High\" : budget > 8000 ? \"Medium\" : \"Low\";\n\n  results.push({\n    json: {\n      campaignName: item.json['Campaign Name'],\n      status: item.json['Status'],\n      daysActive: daysActive,\n      budgetTier: budgetTier,\n      budget: budget\n    }\n  });\n}\n\nreturn results;"
      },
