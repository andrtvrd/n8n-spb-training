    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n\nlet messageText;\nlet campaignLabel;\n\nif (item.campaignName !== undefined) {\n  // Single-campaign shape (main demo flow + reusability proof)\n  const emoji = item.flag === \"overdue\" ? \"⚠️ OVERDUE: \" : \"📅 \";\n  messageText = emoji + item.campaignName + \" — starts in \" + item.daysUntilStart + \" days\";\n  campaignLabel = item.campaignName;\n} else if (item.totalReadyCampaigns !== undefined) {\n  // Summary shape (exercise flow)\n  messageText = \"📊 Summary: \" + item.totalReadyCampaigns + \" Ready campaigns, total budget $\" + Number(item.totalBudget).toLocaleString();\n  campaignLabel = \"Summary\";\n} else {\n  messageText = \"⚠️ Campaign Notifier received an unrecognized payload shape.\";\n  campaignLabel = \"Unknown\";\n}\n\nreturn {\n  json: {\n    messageText: messageText,\n    campaignLabel: campaignLabel\n  }\n};"
      },
